            "title": "Db",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "Member": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Member",
        "type": "object"
      },
      "MemberAdd": {
        "properties": {
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "MemberAdd",
        "type": "object"
      },
      "Progress": {
        "properties": {
          "claimed": {
            "title": "Claimed",
            "type": "integer"
          },
          "done": {
            "title": "Done",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "claimed",
          "done"
        ],
        "title": "Progress",
        "type": "object"
      },
      "Task": {
        "properties": {
          "claimed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
