            "format": "date",
            "title": "End",
            "type": "string"
          },
          "missed_days": {
            "title": "Missed Days",
            "type": "integer"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "title": "Missing",
            "type": "array"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "available",
          "missing",
          "missed_days"
        ],
        "title": "Window",
        "type": "object"
      }
