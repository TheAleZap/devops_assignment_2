            "title": "Priority",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "done",
          "priority",
          "claimed_by"
        ],
        "title": "Task",
        "type": "object"
      },
      "TaskClaim": {
        "properties": {
          "member": {
            "minLength": 1,
