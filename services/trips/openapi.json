            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination"
          },
          "end_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "title": "Members",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "progress": {
            "$ref": "#/components/schemas/Progress"
          },
          "start_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "destination",
          "start_date",
          "end_date",
          "date_poll_id",
          "members",
          "tasks",
          "progress"
        ],
        "title": "Trip",
        "type": "object"
      },
