        "properties": {
          "destination": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination"
          },
          "members": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Members",
            "type": "array"
