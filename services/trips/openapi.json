            "type": "string"
          }
        },
        "required": [
          "member"
        ],
        "title": "TaskClaim",
        "type": "object"
      },
      "TaskCreate": {
        "properties": {
          "priority": {
            "default": "normal",
            "enum": [
              "low",
              "normal",
              "high"
            ],
            "title": "Priority",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "TaskCreate",
        "type": "object"
      },
