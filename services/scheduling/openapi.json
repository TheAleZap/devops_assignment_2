      "get": {
        "operationId": "get_best_windows_api_scheduling_polls__poll_id__best_windows_get",
        "parameters": [
          {
            "in": "path",
            "name": "poll_id",
            "required": true,
            "schema": {
              "title": "Poll Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 20,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Window"
